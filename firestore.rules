rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.username is string;

      // Owner-only update; uid/username/createdAt are immutable.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;

      match /savedWords/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /recents/{friendUid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /usernames/{handle} {
      // Single-doc lookups are public so the signup form can check
      // availability before the user has an auth session. `list` is
      // denied to prevent scraping the handle namespace.
      allow get: if true;
      allow list: if false;

      // `create` only matches when the doc does not exist, so this
      // implicitly enforces uniqueness. The hasOnly(['uid']) guard keeps
      // the document shape locked down.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);

      // Immutable post-creation.
      allow update, delete: if false;
    }

    match /cards/{cardId} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;

      // Recipient can only flip status + decidedAt.
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'decidedAt']);

      allow delete: if false;
    }

    match /groups/{groupId} {
      allow read: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.mode in ['private', 'broadcast', 'community']
        && request.resource.data.memberUids.size() <= 25;

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.memberUids.size() <= 25;

      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
